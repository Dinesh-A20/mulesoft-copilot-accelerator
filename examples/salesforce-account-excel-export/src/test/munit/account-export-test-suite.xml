                                                 whereValue="#['Query changed Accounts']"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[readUrl('classpath://test-data/salesforce-accounts-incremental.json')]" mediaType="application/json"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="file:write">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[payload]" mediaType="application/octet-stream"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="os:store">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[payload]"/>
