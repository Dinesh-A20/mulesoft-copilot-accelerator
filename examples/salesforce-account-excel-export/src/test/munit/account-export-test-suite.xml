        <munit:validation>
            <munit-tools:assert-that expression="#[payload.mode]" is="#[MunitTools::equalTo('incremental')]"/>
            <munit-tools:assert-that expression="#[payload.recordsInserted]" is="#[MunitTools::equalTo(1)]"/>
            <munit-tools:assert-that expression="#[payload.recordsUpdated]" is="#[MunitTools::equalTo(1)]"/>
            <munit-tools:assert-that expression="#[payload.totalRows]" is="#[MunitTools::equalTo(3)]"/>
            <munit-tools:assert-that expression="#[vars.accountQuery]" is="#[MunitTools::containsString('WHERE LastModifiedDate > 2026-11-20T10:00:00Z')]"/>
            <munit-tools:assert-that expression="#[vars.mergeResult.rows.'Account Id']"
                                     is="#[MunitTools::equalTo(['001000000000001AAA', '001000000000002AAA', '001000000000003AAA'])]"/>
            <munit-tools:assert-that expression="#[vars.nextWatermark]"
                                     is="#[MunitTools::equalTo({lastModifiedDate: '2026-11-21T09:30:00Z', id: '001000000000003AAA'})]"/>
            <munit-tools:verify-call processor="os:store" times="1"/>
        </munit:validation>
    </munit:test>

