    <munit:config name="account-export-test-suite"/>

    <munit:test name="account-workbook-merge-updates-in-place-and-appends-new-ids">
        <munit:execution>
            <ee:transform>
                <ee:variables>
                    <ee:set-variable variableName="mergeResult"><![CDATA[%dw 2.0
import mergeAccounts from dwl::AccountWorkbook
output application/java
---
mergeAccounts(
    {Accounts: [
        {'Account Id': '001000000000001AAA', 'Account Name': 'Northwind Demo', Phone: '+1-555-0101', 'Billing City': 'Seattle'},
        {'Account Id': '001000000000009AAA', 'Account Name': 'Manual Row', Phone: '', 'Billing City': ''},
        {'Account Id': '', 'Account Name': '', Phone: '', 'Billing City': ''}
    ]},
    readUrl('classpath://test-data/salesforce-accounts-incremental.json', 'application/json'))]]></ee:set-variable>
                </ee:variables>
            </ee:transform>
            <ee:transform>
                <ee:message>
                    <ee:set-payload resource="dwl/accounts-to-xlsx.dwl"/>
                </ee:message>
            </ee:transform>
            <set-variable variableName="workbook"
                          value="#[read(payload as Binary, 'application/xlsx', {header: true})]"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.mergeResult.inserted]" is="#[MunitTools::equalTo(1)]"/>
            <munit-tools:assert-that expression="#[vars.mergeResult.updated]" is="#[MunitTools::equalTo(1)]"/>
            <munit-tools:assert-that expression="#[vars.workbook.Accounts]"
                                     is="#[MunitTools::equalTo([
                                         {'Account Id': '001000000000001AAA', 'Account Name': 'Northwind Demo Renamed', Phone: '+1-555-0199', 'Billing City': 'Portland'},
                                         {'Account Id': '001000000000009AAA', 'Account Name': 'Manual Row', Phone: '', 'Billing City': ''},
                                         {'Account Id': '001000000000003AAA', 'Account Name': 'Fabrikam Demo', Phone: '+1-555-0103', 'Billing City': 'Austin'}
                                     ])]"/>
        </munit:validation>
    </munit:test>

    <munit:test name="account-query-uses-keyset-watermark">
        <munit:execution>
            <set-variable variableName="incrementalQuery"
                          value="#[dwl::AccountWorkbook::buildAccountQuery({lastModifiedDate: '2026-11-20T10:00:00.000+0000', id: '001000000000001AAA'})]"/>
            <munit-tools:assert-that expression="#[vars.incrementalQuery]"
                                     is="#[MunitTools::equalTo('SELECT Id, Name, Phone, BillingCity, LastModifiedDate FROM Account WHERE LastModifiedDate > 2026-11-20T10:00:00Z OR (LastModifiedDate = 2026-11-20T10:00:00Z AND Id > ''001000000000001AAA'') ORDER BY LastModifiedDate ASC, Id ASC LIMIT 50')]"/>
            <munit-tools:assert-that expression="#[dwl::AccountWorkbook::buildAccountQuery(null)]"
                                     is="#[MunitTools::endsWith('ORDER BY LastModifiedDate DESC, Id DESC LIMIT 50')]"/>
        </munit:execution>
    </munit:test>

    <munit:test name="account-query-rejects-injected-watermark-id"
                expectedErrorType="ANY">
        <munit:execution>
            <set-variable variableName="injected"
                          value="#[dwl::AccountWorkbook::buildAccountQuery({lastModifiedDate: '2026-11-20T10:00:00Z', id: &quot;x' OR Name != '&quot;})]"/>
        </munit:execution>
    </munit:test>

    <munit:test name="account-export-initial-load-when-workbook-missing">
        <munit:behavior>
            <munit-tools:mock-when processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload value="#['']" mediaType="text/plain"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="file:read">
                <munit-tools:then-return>
                    <munit-tools:error typeId="FILE:ILLEGAL_PATH"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="sfdc:query">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name"
                                                 whereValue="#['Query changed Accounts']"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[readUrl('classpath://test-data/salesforce-accounts.json')]" mediaType="application/json"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="file:write">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[payload]" mediaType="application/octet-stream"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="os:store">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[payload]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="account-export-process"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('completed')]"/>
            <munit-tools:assert-that expression="#[payload.mode]" is="#[MunitTools::equalTo('initial')]"/>
            <munit-tools:assert-that expression="#[payload.recordsExported]" is="#[MunitTools::equalTo(2)]"/>
            <munit-tools:assert-that expression="#[payload.recordsInserted]" is="#[MunitTools::equalTo(2)]"/>
            <munit-tools:assert-that expression="#[payload.totalRows]" is="#[MunitTools::equalTo(2)]"/>
            <munit-tools:assert-that expression="#[payload.fileName]" is="#[MunitTools::equalTo('salesforceAccountRecords.xlsx')]"/>
            <munit-tools:assert-that expression="#[payload.correlationId]" is="#[MunitTools::notNullValue()]"/>
            <munit-tools:assert-that expression="#[vars.accountQuery]" is="#[MunitTools::endsWith('ORDER BY LastModifiedDate DESC, Id DESC LIMIT 50')]"/>
            <munit-tools:assert-that expression="#[vars.nextWatermark]"
                                     is="#[MunitTools::equalTo({lastModifiedDate: '2026-11-20T10:00:00Z', id: '001000000000001AAA'})]"/>
            <munit-tools:verify-call processor="file:write" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="path"
                                                 whereValue="#[MunitTools::equalTo('salesforceAccountRecords.xlsx')]"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
            <munit-tools:verify-call processor="os:store" times="1"/>
        </munit:validation>
    </munit:test>

