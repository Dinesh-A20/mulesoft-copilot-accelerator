<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:salesforce="http://www.mulesoft.org/schema/mule/salesforce"
      xmlns:email="http://www.mulesoft.org/schema/mule/email"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/salesforce http://www.mulesoft.org/schema/mule/salesforce/current/mule-salesforce.xsd
        http://www.mulesoft.org/schema/mule/email http://www.mulesoft.org/schema/mule/email/current/mule-email.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">

    <global-property name="env" value="local"/>
    <configuration-properties file="properties/common.yaml"/>
    <configuration-properties file="properties/${env}.yaml"/>

    <!-- OAuth 2.0 JWT Bearer flow: the Connected App's certificate signs the assertion; no user password is stored. -->
    <salesforce:sfdc-config name="salesforce-jwt-config"
                            readTimeout="${salesforce.timeout.readMs}"
                            readTimeoutUnit="MILLISECONDS">
        <salesforce:jwt-connection consumerKey="${salesforce.secure.consumerKey}"
                                   keyStore="${salesforce.jwt.keystorePath}"
                                   storePassword="${salesforce.secure.keystorePassword}"
                                   certificateAlias="${salesforce.jwt.certificateAlias}"
                                   principal="${salesforce.jwt.principal}"
                                   tokenEndpoint="${salesforce.jwt.tokenEndpoint}"
                                   audienceUrl="${salesforce.jwt.audienceUrl}">
            <reconnection failsDeployment="false">
                <reconnect frequency="${salesforce.reconnection.frequencyMs}"
                           count="${salesforce.reconnection.attempts}"/>
            </reconnection>
        </salesforce:jwt-connection>
    </salesforce:sfdc-config>

    <!-- STARTTLS is required: the connection fails instead of falling back to plaintext. -->
    <email:smtp-config name="email-smtp-config" from="${smtp.from}">
        <email:smtp-connection host="${smtp.host}"
                               port="${smtp.port}"
                               user="${smtp.secure.username}"
                               password="${smtp.secure.password}"
                               connectionTimeout="${smtp.timeout.connectMs}"
                               readTimeout="${smtp.timeout.readMs}"
                               writeTimeout="${smtp.timeout.writeMs}"
                               timeoutUnit="MILLISECONDS">
            <email:properties>
                <email:property key="mail.smtp.starttls.enable" value="true"/>
                <email:property key="mail.smtp.starttls.required" value="true"/>
                <email:property key="mail.smtp.ssl.protocols" value="TLSv1.2 TLSv1.3"/>
                <email:property key="mail.smtp.ssl.checkserveridentity" value="true"/>
            </email:properties>
        </email:smtp-connection>
    </email:smtp-config>

    <!-- Account Ids already emailed; prevents duplicates on replay or re-polling. -->
    <os:object-store name="account-notification-sent-store"
                     persistent="true"
                     entryTtl="${notification.dedupe.ttlDays}"
                     entryTtlUnit="DAYS"
                     expirationInterval="1"
                     expirationIntervalUnit="HOURS"/>

    <!-- Notifications that exhausted retries; drained by account-notification-replay-main. -->
    <os:object-store name="account-notification-dlq-store" persistent="true"/>
</mule>
