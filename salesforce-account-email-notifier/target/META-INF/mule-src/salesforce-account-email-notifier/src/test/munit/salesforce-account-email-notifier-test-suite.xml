<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:email="http://www.mulesoft.org/schema/mule/email"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/email http://www.mulesoft.org/schema/mule/email/current/mule-email.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">

    <munit:config name="salesforce-account-email-notifier-test-suite"/>

    <!-- ===================== DataWeave mapping ===================== -->

    <munit:test name="account-notification-mapping-escapes-html-and-normalises-utc">
        <munit:execution>
            <set-variable variableName="account"
                          value="#[dwl::accountNotification::toNotificationAccount(readUrl('classpath://test-data/salesforce-new-account.json', 'application/json'))]"/>
            <set-variable variableName="email"
                          value="#[dwl::accountNotification::buildEmail(vars.account, 'https://example-org.my.salesforce.com/')]"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.account.id]" is="#[MunitTools::equalTo('001000000000001AAA')]"/>
            <munit-tools:assert-that expression="#[vars.account.createdDate]" is="#[MunitTools::equalTo('2026-11-20T06:45:00Z')]"/>
            <munit-tools:assert-that expression="#[vars.account.OwnerId]" is="#[MunitTools::nullValue()]"/>
            <munit-tools:assert-that expression="#[vars.email.subject]"
                                     is="#[MunitTools::equalTo('New Salesforce Account created: Northwind &lt;Demo&gt; &amp; Sons')]"/>
            <munit-tools:assert-that expression="#[vars.email.body]"
                                     is="#[MunitTools::containsString('Northwind &amp;lt;Demo&amp;gt; &amp;amp; Sons')]"/>
            <munit-tools:assert-that expression="#[vars.email.body]"
                                     is="#[MunitTools::containsString('https://example-org.my.salesforce.com/lightning/r/Account/001000000000001AAA/view')]"/>
            <munit-tools:assert-that expression="#[vars.email.body]"
                                     is="#[MunitTools::containsString('Seattle')]"/>
        </munit:validation>
    </munit:test>

    <munit:test name="account-notification-mapping-handles-nulls-and-header-injection">
        <munit:execution>
            <set-variable variableName="account"
                          value="#[dwl::accountNotification::toNotificationAccount({Id: '001000000000002', Name: 'Evil\r\nBcc: attacker@example.com', Phone: '  ', BillingCity: null})]"/>
            <set-variable variableName="email"
                          value="#[dwl::accountNotification::buildEmail(vars.account, 'https://example-org.my.salesforce.com')]"/>
            <set-variable variableName="unnamedSubject"
                          value="#[dwl::accountNotification::toSubject(null)]"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.account.phone]" is="#[MunitTools::nullValue()]"/>
            <munit-tools:assert-that expression="#[vars.account.billingCity]" is="#[MunitTools::nullValue()]"/>
            <munit-tools:assert-that expression="#[vars.account.createdDate]" is="#[MunitTools::nullValue()]"/>
            <munit-tools:assert-that expression="#[vars.email.subject]"
                                     is="#[MunitTools::equalTo('New Salesforce Account created: Evil Bcc: attacker@example.com')]"/>
            <munit-tools:assert-that expression="#[vars.email.body]"
                                     is="#[MunitTools::containsString('&lt;th align=&quot;left&quot;&gt;Phone&lt;/th&gt;&lt;td&gt;-&lt;/td&gt;')]"/>
            <munit-tools:assert-that expression="#[vars.unnamedSubject]"
                                     is="#[MunitTools::equalTo('New Salesforce Account created: Unnamed Account')]"/>
        </munit:validation>
    </munit:test>

    <munit:test name="account-notification-mapping-truncates-long-subject-and-splits-recipients">
        <munit:execution>
            <set-variable variableName="subject"
                          value="#[dwl::accountNotification::toSubject(dw::core::Strings::repeat('x', 200))]"/>
            <set-variable variableName="recipients"
                          value="#[dwl::accountNotification::toRecipients(' a@example.com, ,b@example.com ')]"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[sizeOf(vars.subject)]" is="#[MunitTools::equalTo(155)]"/>
            <munit-tools:assert-that expression="#[vars.subject]" is="#[MunitTools::endsWith('...')]"/>
            <munit-tools:assert-that expression="#[vars.recipients]" is="#[MunitTools::equalTo(['a@example.com', 'b@example.com'])]"/>
        </munit:validation>
    </munit:test>

    <munit:test name="account-notification-mapping-rejects-invalid-id"
                expectedErrorType="MULE:EXPRESSION">
        <munit:execution>
            <set-variable variableName="account"
                          value="#[dwl::accountNotification::toNotificationAccount({Id: &quot;001' OR 1=1&quot;, Name: 'Bad'})]"/>
        </munit:execution>
    </munit:test>

    <munit:test name="account-notification-mapping-rejects-empty-recipients"
                expectedErrorType="MULE:EXPRESSION">
        <munit:execution>
            <set-variable variableName="recipients"
                          value="#[dwl::accountNotification::toRecipients(' , ')]"/>
        </munit:execution>
    </munit:test>

    <!-- ===================== Main flow ===================== -->

    <munit:test name="salesforce-account-created-main-sends-email-for-new-account">
        <munit:behavior>
            <munit-tools:mock-when processor="os:contains">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[false]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="email:send"/>
            <munit-tools:mock-when processor="os:store"/>
        </munit:behavior>
        <munit:execution>
            <set-payload value="#[readUrl('classpath://test-data/salesforce-new-account.json', 'application/json')]"/>
            <flow-ref name="salesforce-account-created-main"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.notificationStatus]" is="#[MunitTools::equalTo('sent')]"/>
            <munit-tools:assert-that expression="#[vars.email.recipients]"
                                     is="#[MunitTools::equalTo(['ops@example.com', 'owner@example.com'])]"/>
            <munit-tools:assert-that expression="#[vars.email.subject]"
                                     is="#[MunitTools::startsWith('New Salesforce Account created: Northwind')]"/>
            <munit-tools:verify-call processor="email:send" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="config-ref" whereValue="email-smtp-config"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
            <munit-tools:verify-call processor="os:store" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Mark as notified"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
            <munit-tools:verify-call processor="os:store" times="0">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Store in DLQ"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

    <munit:test name="salesforce-account-created-main-skips-already-notified-account">
        <munit:behavior>
            <munit-tools:mock-when processor="os:contains">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[true]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="email:send"/>
            <munit-tools:mock-when processor="os:store"/>
        </munit:behavior>
        <munit:execution>
            <set-payload value="#[readUrl('classpath://test-data/salesforce-new-account.json', 'application/json')]"/>
            <flow-ref name="salesforce-account-created-main"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.notificationStatus]" is="#[MunitTools::equalTo('skipped-duplicate')]"/>
            <munit-tools:verify-call processor="email:send" times="0"/>
            <munit-tools:verify-call processor="os:store" times="0"/>
        </munit:validation>
    </munit:test>

    <munit:test name="salesforce-account-created-main-smtp-failure-retries-then-dead-letters">
        <munit:behavior>
            <munit-tools:mock-when processor="os:contains">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[false]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="email:send">
                <munit-tools:then-return>
                    <munit-tools:error typeId="EMAIL:SEND"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="os:store"/>
        </munit:behavior>
        <munit:execution>
            <set-payload value="#[readUrl('classpath://test-data/salesforce-new-account.json', 'application/json')]"/>
            <flow-ref name="salesforce-account-created-main"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.notificationStatus]" is="#[MunitTools::equalTo('dead-lettered')]"/>
            <!-- maxRetries=2 in test => 1 attempt + 2 retries -->
            <munit-tools:verify-call processor="email:send" times="3"/>
            <munit-tools:verify-call processor="os:store" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Store in DLQ"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
            <munit-tools:verify-call processor="os:store" times="0">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Mark as notified"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

    <munit:test name="salesforce-account-created-main-smtp-timeout-dead-letters">
        <munit:behavior>
            <munit-tools:mock-when processor="os:contains">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[false]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="email:send">
                <munit-tools:then-return>
                    <munit-tools:error typeId="EMAIL:CONNECTIVITY"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="os:store"/>
        </munit:behavior>
        <munit:execution>
            <set-payload value="#[readUrl('classpath://test-data/salesforce-new-account.json', 'application/json')]"/>
            <flow-ref name="salesforce-account-created-main"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.notificationStatus]" is="#[MunitTools::equalTo('dead-lettered')]"/>
            <munit-tools:verify-call processor="os:store" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Store in DLQ"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

    <munit:test name="salesforce-account-created-main-object-store-failure-dead-letters">
        <munit:behavior>
            <munit-tools:mock-when processor="os:contains">
                <munit-tools:then-return>
                    <munit-tools:error typeId="OS:STORE_NOT_AVAILABLE"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="email:send"/>
            <munit-tools:mock-when processor="os:store"/>
        </munit:behavior>
        <munit:execution>
            <set-payload value="#[readUrl('classpath://test-data/salesforce-new-account.json', 'application/json')]"/>
            <flow-ref name="salesforce-account-created-main"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.notificationStatus]" is="#[MunitTools::equalTo('dead-lettered')]"/>
            <munit-tools:verify-call processor="email:send" times="0"/>
        </munit:validation>
    </munit:test>

    <munit:test name="salesforce-account-created-main-invalid-record-is-rejected">
        <munit:behavior>
            <munit-tools:mock-when processor="os:contains"/>
            <munit-tools:mock-when processor="email:send"/>
            <munit-tools:mock-when processor="os:store"/>
        </munit:behavior>
        <munit:execution>
            <set-payload value="#[{Id: null, Name: 'No Id'}]"/>
            <flow-ref name="salesforce-account-created-main"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.notificationStatus]" is="#[MunitTools::equalTo('rejected-invalid-record')]"/>
            <munit-tools:verify-call processor="os:contains" times="0"/>
            <munit-tools:verify-call processor="email:send" times="0"/>
            <munit-tools:verify-call processor="os:store" times="0"/>
        </munit:validation>
    </munit:test>

    <!-- ===================== Replay flow ===================== -->

    <munit:test name="account-notification-replay-main-resends-and-removes-entry">
        <munit:behavior>
            <munit-tools:mock-when processor="os:retrieve-all-keys">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[['001000000000001AAA']]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[output application/java --- {account: {id: '001000000000001AAA', name: 'Northwind Demo', phone: null, billingCity: 'Seattle', billingCountry: null, industry: null, accountType: null, createdDate: '2026-11-20T06:45:00Z'}}]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="os:contains">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[false]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="email:send"/>
            <munit-tools:mock-when processor="os:store"/>
            <munit-tools:mock-when processor="os:remove"/>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="account-notification-replay-main"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.notificationStatus]" is="#[MunitTools::equalTo('sent')]"/>
            <munit-tools:verify-call processor="email:send" times="1"/>
            <munit-tools:verify-call processor="os:store" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Mark as notified"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
            <munit-tools:verify-call processor="os:remove" times="1"/>
        </munit:validation>
    </munit:test>

    <munit:test name="account-notification-replay-main-failure-retains-entry">
        <munit:behavior>
            <munit-tools:mock-when processor="os:retrieve-all-keys">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[['001000000000001AAA']]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[output application/java --- {account: {id: '001000000000001AAA', name: 'Northwind Demo'}}]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="os:contains">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[false]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="email:send">
                <munit-tools:then-return>
                    <munit-tools:error typeId="EMAIL:CONNECTIVITY"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="os:store"/>
            <munit-tools:mock-when processor="os:remove"/>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="account-notification-replay-main"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:verify-call processor="email:send" times="3"/>
            <munit-tools:verify-call processor="os:remove" times="0"/>
            <munit-tools:verify-call processor="os:store" times="0"/>
        </munit:validation>
    </munit:test>

    <munit:test name="account-notification-replay-main-empty-dlq-does-nothing">
        <munit:behavior>
            <munit-tools:mock-when processor="os:retrieve-all-keys">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[[]]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="os:retrieve"/>
            <munit-tools:mock-when processor="email:send"/>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="account-notification-replay-main"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:verify-call processor="os:retrieve" times="0"/>
            <munit-tools:verify-call processor="email:send" times="0"/>
        </munit:validation>
    </munit:test>
</mule>
