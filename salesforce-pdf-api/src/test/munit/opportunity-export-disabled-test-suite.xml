<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:munit="http://www.mulesoft.org/schema/mule/munit" xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
  <munit:config name="opportunity-disabled-test-config"/>
  <munit:test name="opportunity-nonlocal-environment-fails-closed" description="AC-33 AC-42: nonlocal environment cannot export even with enabled/started flags">
    <munit:behavior>
      <munit-tools:mock-when processor="salesforce:describe-sobject"><munit-tools:then-return><munit-tools:error typeId="SALESFORCE:INVALID_INPUT"/></munit-tools:then-return></munit-tools:mock-when>
      <munit-tools:mock-when processor="salesforce:query"><munit-tools:then-return><munit-tools:error typeId="SALESFORCE:INVALID_INPUT"/></munit-tools:then-return></munit-tools:mock-when>
    </munit:behavior>
    <munit:execution><flow-ref name="salesforce-opportunity-export-main"/></munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[p('mule.env')]" is="#[MunitTools::equalTo('dev')]"/>
      <munit-tools:assert-that expression="#[p('etl.enabled')]" is="#[MunitTools::equalTo('true')]"/>
      <munit-tools:verify-call processor="salesforce:describe-sobject" times="0"/>
      <munit-tools:verify-call processor="salesforce:query" times="0"/>
      <munit-tools:verify-call processor="file:write" times="0"/>
      <munit-tools:verify-call processor="flow-ref" times="0"><munit-tools:with-attributes><munit-tools:with-attribute attributeName="name" whereValue="opportunity-export-process"/></munit-tools:with-attributes></munit-tools:verify-call>
    </munit:validation>
  </munit:test>
</mule>
