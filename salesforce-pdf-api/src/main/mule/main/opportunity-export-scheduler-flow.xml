<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">
  <flow name="salesforce-opportunity-export-main" initialState="${etl.initial-state}" maxConcurrency="1" doc:description="BO-03 FR-30 ERR-34 DEP-30">
    <scheduler disallowConcurrentExecution="true">
      <scheduling-strategy><cron expression="${etl.schedule}" timeZone="${etl.timezone}"/></scheduling-strategy>
    </scheduler>
    <choice>
      <when expression="#[p('mule.env') == 'local' and p('etl.enabled') == 'true']">
        <flow-ref name="opportunity-export-process"/>
      </when>
      <otherwise>
        <logger level="INFO" message="#[write({flowName: 'salesforce-opportunity-export-main', correlationId: correlationId, environment: p('mule.env'), status: 'ETL_DISABLED'}, 'application/json', {indent: false})]"/>
      </otherwise>
    </choice>
  </flow>
</mule>
