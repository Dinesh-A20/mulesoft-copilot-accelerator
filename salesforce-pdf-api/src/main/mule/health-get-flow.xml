<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">
  <flow name="health-get-process" doc:description="FR-11 AC-15">
    <set-variable variableName="routeTemplate" value="/health"/>
    <set-variable variableName="httpStatus" value="#[200]"/>
    <set-variable variableName="responseMediaType" value="application/json"/>
    <set-payload value="#[write({status: 'UP'}, 'application/json', {indent: false})]" mimeType="application/json"/>
    <set-variable variableName="responseBytes" value="#[sizeOf(payload as Binary {encoding: 'UTF-8'})]"/>
  </flow>
</mule>
